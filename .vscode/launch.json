{
  "version": "0.2.0",
  "configurations": [{
    "name": "DSU IDE: Extension Development",
    "type": "extensionHost", "request": "launch",
    "args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/dsu-ide", "--enable-proposed-api=dsu.dsu-ide"],
    "outFiles": ["${workspaceFolder}/packages/dsu-ide/dist/**/*.js"],
    "preLaunchTask": "build"
  }]
}
