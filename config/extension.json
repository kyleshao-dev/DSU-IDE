{
  "name": "dsu-ide",
  "displayName": "DSU IDE",
  "description": "DSU IDE 内置做题工作台",
  "version": "0.1.2",
  "publisher": "dsu",
  "license": "MIT",
  "engines": {
    "vscode": "^1.110.0"
  },
  "main": "./dist/extension.js",
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "enabledApiProposals": [
    "browser"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:dsu.home"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "创建文件和运行代码需要信任工作区"
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "dsu.openBrowser",
        "title": "DSU: 打开内置浏览器",
        "icon": "$(globe)"
      },
      {
        "command": "dsu.configure",
        "title": "DSU: 编辑 OJ、语言与模板配置"
      },
      {
        "command": "dsu.updateAdapters",
        "title": "DSU: 更新内置 OJ 配置"
      },
      {
        "command": "dsu.pair",
        "title": "DSU: 复制浏览器配对信息"
      },
      {
        "command": "dsu.test",
        "title": "DSU: 一键测试样例",
        "icon": "$(play)"
      },
      {
        "command": "dsu.submit",
        "title": "DSU: 提交当前题目"
      },
      {
        "command": "dsu.record",
        "title": "DSU: 打开当前题目的提交记录"
      },
      {
        "command": "dsu.cancel",
        "title": "DSU: 取消测试与待提交任务"
      },
      {
        "command": "dsu.language",
        "title": "DSU: 切换当前题目语言"
      },
      {
        "command": "dsu.samples",
        "title": "DSU: 显示样例面板"
      },
      {
        "command": "dsu.saveTemplate",
        "title": "DSU: 保存选中代码为模板"
      },
      {
        "command": "dsu.setup",
        "title": "DSU: 开始使用：选择默认语言"
      },
      {
        "command": "dsu.doctor",
        "title": "DSU: 检查语言环境"
      },
      {
        "command": "dsu.openProblem",
        "title": "DSU: 打开已导入题目"
      },
      {
        "command": "dsu.refreshProblems",
        "title": "DSU: 刷新题目与文件",
        "icon": "$(refresh)"
      },
      {
        "command": "dsu.home",
        "title": "DSU: 打开主页",
        "icon": "$(home)"
      }
    ],
    "keybindings": [
      {
        "command": "dsu.test",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      }
    ],
    "configuration": {
      "title": "DSU IDE",
      "properties": {
        "dsu.bridgePort": {
          "type": "number",
          "default": 27121,
          "minimum": 1024,
          "maximum": 65535,
          "scope": "application",
          "description": "外部浏览器连接端口，修改后重新加载窗口。"
        },
        "dsu.submissionBrowser": {
          "type": "string",
          "enum": [
            "integrated",
            "external"
          ],
          "default": "integrated",
          "description": "提交时打开内置浏览器或系统默认浏览器（需安装 DSU Companion）。"
        }
      }
    },
    "configurationDefaults": {
      "editor.snippetSuggestions": "top",
      "editor.tabCompletion": "on",
      "workbench.startupEditor": "none",
      "chat.disableAIFeatures": true,
      "chat.titleBar.signIn.enabled": false,
      "workbench.secondarySideBar.defaultVisibility": "hidden",
      "window.commandCenter": false,
      "workbench.layoutControl.enabled": false,
      "editor.minimap.enabled": false,
      "breadcrumbs.enabled": false,
      "workbench.tips.enabled": false,
      "telemetry.telemetryLevel": "off",
      "workbench.activityBar.location": "hidden",
      "workbench.statusBar.visible": false,
      "workbench.editor.showTabs": "single",
      "explorer.compactFolders": false,
      "files.exclude": {
        "**/.dsu": true
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "dsu.openBrowser",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation@10"
        }
      ],
      "editor/title": [
        {
          "command": "dsu.home",
          "group": "navigation@1"
        },
        {
          "command": "dsu.test",
          "when": "resourceScheme == file",
          "group": "navigation@2"
        },
        {
          "command": "dsu.submit",
          "when": "resourceScheme == file",
          "group": "1_dsu@1"
        },
        {
          "command": "dsu.openProblem",
          "group": "1_dsu@2"
        },
        {
          "command": "dsu.openBrowser",
          "group": "1_dsu@3"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "**/.dsu/config.json",
        "url": "./config.schema.json"
      }
    ]
  },
  "files": [
    "dist/**",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ]
}
